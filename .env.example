# Copy to .env and adjust before: docker compose up -d

APP_USER=admin
# Min. 12 characters, upper, lower, digit, and symbol
APP_PASSWORD=ChangeThisPassword123!

# Optional: Flask session key (32+ bytes). If unset, saved to .secret_key
# SECRET_KEY=

# Secure cookies only with HTTPS (reverse proxy). Use false for local HTTP
SESSION_COOKIE_SECURE=false
